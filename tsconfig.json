{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "resolveJsonModule": true,

    "ignoreDeprecations": "6.0"
  },
  "include": ["features/**/*.ts", "pageObjects/**/*.ts"]
}